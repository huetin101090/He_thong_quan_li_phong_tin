# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# When deploying to Vercel or Netlify: Add GEMINI_API_KEY under Project / Site Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# When deploying to Vercel / Netlify: Set to your deployment URL (e.g. https://your-project.vercel.app or https://your-site.netlify.app)
APP_URL="MY_APP_URL"

# SUPABASE: Cấu hình kết nối Cơ sở dữ liệu đám mây
# Lấy tại Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SUPABASE_SERVICE_ROLE_KEY: Khóa bảo mật phía máy chủ (Server-side Secret Key)
# Dùng để ghi hash bcrypt vào public.student_credentials trên Supabase.
# TUYỆT ĐỐI KHÔNG thêm tiền tố VITE_ và không công khai cho trình duyệt.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# TEACHER_ADMIN_KEY: Mật khẩu xác thực Giáo viên / Quản trị viên trên máy chủ trước khi cấp PIN
# Mặc định hệ thống: "DongDuong@2026"
TEACHER_ADMIN_KEY="DongDuong@2026"



